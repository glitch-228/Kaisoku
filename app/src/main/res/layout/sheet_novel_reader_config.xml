<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:fillViewport="true">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:padding="@dimen/screen_padding">

		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingBottom="16dp"
			android:text="@string/novel_reader_settings"
			android:textAppearance="?attr/textAppearanceTitleLarge" />

		<com.google.android.material.card.MaterialCardView
			android:id="@+id/cardPreview"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginBottom="20dp"
			app:cardElevation="0dp"
			app:shapeAppearance="?attr/shapeAppearanceCornerLarge"
			app:strokeColor="?attr/colorOutlineVariant"
			app:strokeWidth="1dp">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:padding="18dp">

				<TextView
					android:id="@+id/textPreviewCaption"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:alpha="0.72"
					android:text="@string/novel_preview_caption"
					android:textAppearance="?attr/textAppearanceLabelMedium" />

				<TextView
					android:id="@+id/textPreviewTitle"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="12dp"
					android:text="@string/novel_preview_title"
					android:textAppearance="?attr/textAppearanceTitleMedium"
					android:textStyle="bold" />

				<TextView
					android:id="@+id/textPreviewBody"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="10dp"
					android:text="@string/novel_preview_body"
					android:textAppearance="?attr/textAppearanceBodyLarge" />
			</LinearLayout>
		</com.google.android.material.card.MaterialCardView>

		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:text="@string/novel_reading_mode"
			android:textAppearance="?attr/textAppearanceTitleMedium" />

		<com.google.android.material.button.MaterialButtonToggleGroup
			android:id="@+id/toggleGroupReadingMode"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp"
			android:layout_marginBottom="16dp"
			app:selectionRequired="true"
			app:singleSelection="true">

			<Button
				android:id="@+id/btnModePaged"
				style="?attr/materialButtonOutlinedStyle"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:text="@string/novel_mode_paged" />

			<Button
				android:id="@+id/btnModeScroll"
				style="?attr/materialButtonOutlinedStyle"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:text="@string/novel_mode_scroll" />
		</com.google.android.material.button.MaterialButtonToggleGroup>

		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:text="@string/novel_page_turn_animation"
			android:textAppearance="?attr/textAppearanceTitleMedium" />

		<com.google.android.material.button.MaterialButtonToggleGroup
			android:id="@+id/toggleGroupPageTurnAnimation"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp"
			android:layout_marginBottom="16dp"
			app:selectionRequired="true"
			app:singleSelection="true">

			<Button
				android:id="@+id/btnAnimationSlide"
				style="?attr/materialButtonOutlinedStyle"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:text="@string/novel_page_turn_slide" />

			<Button
				android:id="@+id/btnAnimationSimulation"
				style="?attr/materialButtonOutlinedStyle"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:text="@string/novel_page_turn_simulation" />
		</com.google.android.material.button.MaterialButtonToggleGroup>

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:gravity="center_vertical"
			android:orientation="horizontal">

			<TextView
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:text="@string/novel_font_size"
				android:textAppearance="?attr/textAppearanceTitleMedium" />

			<TextView
				android:id="@+id/textFontSizeValue"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="17.0sp"
				android:textAppearance="?attr/textAppearanceBodyMedium"
				android:textColor="?attr/colorPrimary" />
		</LinearLayout>

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:gravity="center_vertical"
			android:orientation="horizontal">

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:paddingEnd="8dp"
				android:text="A"
				android:textSize="12sp" />

			<com.google.android.material.slider.Slider
				android:id="@+id/sliderFontSize"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:stepSize="0.5"
				android:value="17"
				android:valueFrom="14"
				android:valueTo="24" />

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:paddingStart="8dp"
				android:text="A"
				android:textSize="24sp" />
		</LinearLayout>

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="16dp"
			android:gravity="center_vertical"
			android:orientation="horizontal">

			<TextView
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:text="@string/novel_line_spacing"
				android:textAppearance="?attr/textAppearanceTitleMedium" />

			<TextView
				android:id="@+id/textLineSpacingValue"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="1.6"
				android:textAppearance="?attr/textAppearanceBodyMedium"
				android:textColor="?attr/colorPrimary" />
		</LinearLayout>

		<com.google.android.material.slider.Slider
			android:id="@+id/sliderLineSpacing"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:stepSize="0.1"
			android:value="1.6"
			android:valueFrom="1.2"
			android:valueTo="2.0" />

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="16dp"
			android:gravity="center_vertical"
			android:orientation="horizontal">

			<TextView
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:text="@string/novel_paragraph_spacing"
				android:textAppearance="?attr/textAppearanceTitleMedium" />

			<TextView
				android:id="@+id/textParagraphSpacingValue"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/novel_paragraph_spacing_follow_line"
				android:textAppearance="?attr/textAppearanceBodyMedium"
				android:textColor="?attr/colorPrimary" />
		</LinearLayout>

		<com.google.android.material.slider.Slider
			android:id="@+id/sliderParagraphSpacing"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:stepSize="1"
			android:value="0"
			android:valueFrom="0"
			android:valueTo="24" />

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="16dp"
			android:gravity="center_vertical"
			android:orientation="horizontal">

			<TextView
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:text="@string/novel_margin_horizontal"
				android:textAppearance="?attr/textAppearanceTitleMedium" />

			<TextView
				android:id="@+id/textMarginHorizontalValue"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="36dp"
				android:textAppearance="?attr/textAppearanceBodyMedium"
				android:textColor="?attr/colorPrimary" />
		</LinearLayout>

		<com.google.android.material.slider.Slider
			android:id="@+id/sliderMarginHorizontal"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:stepSize="4"
			android:value="36"
			android:valueFrom="12"
			android:valueTo="120" />

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp"
			android:gravity="center_vertical"
			android:orientation="horizontal">

			<TextView
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:text="@string/novel_margin_vertical"
				android:textAppearance="?attr/textAppearanceTitleMedium" />

			<TextView
				android:id="@+id/textMarginVerticalValue"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="36dp"
				android:textAppearance="?attr/textAppearanceBodyMedium"
				android:textColor="?attr/colorPrimary" />
		</LinearLayout>

		<com.google.android.material.slider.Slider
			android:id="@+id/sliderMarginVertical"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:stepSize="4"
			android:value="36"
			android:valueFrom="12"
			android:valueTo="120" />

		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="16dp"
			android:text="@string/novel_theme_preset"
			android:textAppearance="?attr/textAppearanceTitleMedium" />

		<com.google.android.material.button.MaterialButtonToggleGroup
			android:id="@+id/toggleGroupThemePreset"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp"
			android:layout_marginBottom="8dp"
			app:selectionRequired="true"
			app:singleSelection="true">

			<Button
				android:id="@+id/btnThemePaper"
				style="?attr/materialButtonOutlinedStyle"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:text="@string/novel_theme_paper" />

			<Button
				android:id="@+id/btnThemeSepia"
				style="?attr/materialButtonOutlinedStyle"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:text="@string/novel_theme_sepia" />

			<Button
				android:id="@+id/btnThemeMoss"
				style="?attr/materialButtonOutlinedStyle"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:text="@string/novel_theme_moss" />

			<Button
				android:id="@+id/btnThemeSlate"
				style="?attr/materialButtonOutlinedStyle"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:text="@string/novel_theme_slate" />
		</com.google.android.material.button.MaterialButtonToggleGroup>

		<com.google.android.material.materialswitch.MaterialSwitch
			android:id="@+id/switchParagraphIndent"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="16dp"
			android:text="@string/novel_first_line_indent" />

		<com.google.android.material.materialswitch.MaterialSwitch
			android:id="@+id/switchDualPage"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp"
			android:text="@string/novel_dual_page_mode" />

		<com.google.android.material.materialswitch.MaterialSwitch
			android:id="@+id/switchFullscreen"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp"
			android:text="@string/novel_fullscreen_mode" />

		<com.google.android.material.materialswitch.MaterialSwitch
			android:id="@+id/switchShowReadingStatus"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp"
			android:text="@string/novel_show_reading_status" />

		<com.google.android.material.materialswitch.MaterialSwitch
			android:id="@+id/switchReadingStatusTransparent"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp"
			android:text="@string/novel_transparent_status_bar" />

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="24dp"
			android:orientation="horizontal">

			<com.google.android.material.button.MaterialButton
				android:id="@+id/buttonBookmark"
				style="?attr/materialButtonOutlinedStyle"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginEnd="8dp"
				android:text="@string/bookmark_add"
				app:icon="@drawable/ic_bookmark" />

			<Space
				android:layout_width="0dp"
				android:layout_height="1dp"
				android:layout_weight="1" />

			<com.google.android.material.button.MaterialButton
				android:id="@+id/buttonReset"
				style="?attr/materialButtonOutlinedStyle"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginEnd="8dp"
				android:text="@string/reset" />

			<com.google.android.material.button.MaterialButton
				android:id="@+id/buttonClose"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@android:string/ok" />
		</LinearLayout>

	</LinearLayout>

</androidx.core.widget.NestedScrollView>
