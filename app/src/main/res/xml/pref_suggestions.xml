<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:title="@string/suggestions">

	<SwitchPreferenceCompat
		android:defaultValue="false"
		android:key="suggestions"
		android:layout="@layout/preference_toggle_header"
		android:title="@string/suggestions_enable" />

    <SwitchPreferenceCompat android:key="suggestions_legacy" android:defaultValue="false"
        android:title="@string/recommendations_legacy" android:summary="@string/recommendations_legacy_summary" />
    <SwitchPreferenceCompat android:key="suggestions_title_only" android:defaultValue="false"
        android:title="@string/recommendations_title_only" android:summary="@string/recommendations_title_only_summary" />
    <SeekBarPreference android:key="suggestions_diversity" android:defaultValue="50" android:max="100"
        android:title="@string/recommendations_diversity" app:min="0" app:showSeekBarValue="false" />
    <SwitchPreferenceCompat android:key="suggestions_started" android:defaultValue="true"
        android:title="@string/recommendations_started" android:summary="@string/recommendations_started_summary" />
    <SeekBarPreference android:key="suggestions_release_threshold" android:defaultValue="25" android:max="100"
        android:title="@string/recommendations_threshold" app:min="1" app:showSeekBarValue="true" />
    <MultiSelectListPreference android:key="suggestions_languages" android:title="@string/recommendations_languages"
        android:summary="@string/recommendations_languages_summary" />
    <SwitchPreferenceCompat android:key="suggestions_public" android:defaultValue="false"
        android:title="@string/recommendations_public" android:summary="@string/recommendations_public_summary" />
    <Preference android:key="recommendations_clear_dismissals" android:persistent="false"
        android:title="@string/recommendations_clear_dismissals" />
    <Preference android:key="recommendations_beta_info" android:persistent="false" android:selectable="false"
        android:title="@string/recommendations_beta" android:summary="@string/recommendations_info" />

	<SwitchPreferenceCompat
		android:defaultValue="false"
		android:dependency="suggestions"
		android:key="suggestions_wifi"
		android:summary="@string/suggestions_wifi_only_summary"
		android:title="@string/only_using_wifi" />

	<SwitchPreferenceCompat
		android:defaultValue="false"
		android:dependency="suggestions"
		android:key="suggestions_disabled_sources"
		android:summary="@string/suggestions_disabled_sources_summary"
		android:title="@string/include_disabled_sources" />

	<SwitchPreferenceCompat
		android:defaultValue="false"
		android:dependency="suggestions"
		android:key="suggestions_notifications"
		android:summary="@string/suggestions_notifications_summary"
		android:title="@string/notifications_enable" />

	<org.koitharu.kotatsu.settings.utils.MultiAutoCompleteTextViewPreference
		android:dependency="suggestions"
		android:key="suggestions_exclude_tags"
		android:summary="@string/suggestions_excluded_genres_summary"
		android:title="@string/suggestions_excluded_genres"
		app:allowDividerAbove="true" />

	<SwitchPreferenceCompat
		android:defaultValue="false"
		android:dependency="suggestions"
		android:key="suggestions_exclude_nsfw"
		android:summary="@string/exclude_nsfw_from_suggestions_summary"
		android:title="@string/exclude_nsfw_from_suggestions" />

	<Preference
		android:icon="@drawable/ic_info_outline"
		android:key="track_warning"
		android:persistent="false"
		android:selectable="false"
		android:summary="@string/suggestions_info"
		app:allowDividerAbove="true" />

</PreferenceScreen>
