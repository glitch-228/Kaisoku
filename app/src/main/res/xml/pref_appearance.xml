<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/appearance">

    <SwitchPreferenceCompat
        android:key="animated_menus"
        android:defaultValue="false"
        android:title="@string/animated_menus"
        android:summary="@string/animated_menus_summary" />

    <SwitchPreferenceCompat
        android:key="bar_blur"
        android:defaultValue="false"
        android:title="@string/bar_blur"
        android:summary="@string/bar_blur_summary" />

    <SwitchPreferenceCompat
        android:key="tv_launcher"
        android:defaultValue="false"
        android:title="@string/tv_launcher"
        android:summary="@string/tv_launcher_summary" />

    <org.koitharu.kotatsu.settings.utils.ThemeChooserPreference
        android:key="color_theme"
        android:title="@string/color_theme" />

    <Preference
        android:key="custom_themes_management"
        android:persistent="false"
        android:title="@string/custom_themes"
        android:summary="@string/custom_themes_none" />

    <Preference
        android:key="custom_theme_import"
        android:persistent="false"
        android:title="@string/custom_theme_import"
        android:summary="@string/custom_theme_import_summary" />

    <Preference
        android:key="custom_theme_delete"
        android:persistent="false"
        android:title="@string/custom_theme_delete"
        android:summary="@string/custom_themes_none" />

    <Preference
        android:key="wallpaper_palette_refresh"
        android:persistent="false"
        android:title="@string/wallpaper_palette_refresh" />

    <ListPreference
        android:defaultValue="-1"
        android:entries="@array/themes"
        android:entryValues="@array/values_theme"
        android:key="theme"
        android:title="@string/theme"
        app:useSimpleSummaryProvider="true" />

    <SwitchPreferenceCompat
        android:defaultValue="false"
        android:key="amoled_theme"
        android:summary="@string/black_dark_theme_summary"
        android:title="@string/black_dark_theme" />

    <SwitchPreferenceCompat
        android:defaultValue="true"
        android:dependency="amoled_theme"
        android:key="amoled_navbar"
        android:summary="@string/amoled_navbar_summary"
        android:title="@string/amoled_navbar" />

    <org.koitharu.kotatsu.settings.utils.ActivityListPreference
        android:key="app_locale"
        android:title="@string/language" />

    <PreferenceCategory android:title="@string/manga_list">

        <SwitchPreferenceCompat
            android:key="cover_preload"
            android:defaultValue="false"
            android:title="@string/cover_preload"
            android:summary="@string/cover_preload_summary" />

        <SwitchPreferenceCompat
            android:key="cover_refresh_action"
            android:defaultValue="false"
            android:title="@string/cover_refresh_action"
            android:summary="@string/cover_refresh_action_summary" />

        <ListPreference
            android:entries="@array/list_modes"
            android:key="list_mode_2"
            android:title="@string/list_mode"
            app:useSimpleSummaryProvider="true" />

        <org.koitharu.kotatsu.settings.utils.SliderPreference
            android:key="grid_size"
            android:stepSize="5"
            android:title="@string/grid_size"
            android:valueFrom="50"
            android:valueTo="150"
            app:defaultValue="100" />

        <SwitchPreferenceCompat
            android:key="grid_fixed_columns"
            android:defaultValue="false"
            android:title="@string/fixed_grid_columns"
            android:summary="@string/fixed_grid_columns_summary" />

        <org.koitharu.kotatsu.settings.utils.SliderPreference
            android:key="grid_columns"
            android:dependency="grid_fixed_columns"
            android:title="@string/grid_columns"
            android:valueFrom="1"
            android:valueTo="12"
            android:stepSize="1"
            app:defaultValue="3" />

        <SwitchPreferenceCompat
            android:key="favorites_overview"
            android:defaultValue="false"
            android:title="@string/favorites_overview"
            android:summary="@string/favorites_overview_summary" />

        <SwitchPreferenceCompat
            android:key="search_favorite_categories"
            android:defaultValue="false"
            android:title="@string/search_favorite_categories"
            android:summary="@string/search_favorite_categories_summary" />

        <ListPreference
            android:key="favorites_category_sort"
            android:defaultValue="MANUAL"
            android:entries="@array/favorites_category_sorts"
            android:entryValues="@array/favorites_category_sort_values"
            android:title="@string/favorites_category_sort"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            android:key="favorites_category_sort_ascending"
            android:defaultValue="true"
            android:title="@string/favorites_category_sort_ascending" />

        <ListPreference
            android:key="list_long_press_delay"
            android:defaultValue="0"
            android:entries="@array/list_long_press_delays"
            android:entryValues="@array/list_long_press_delay_values"
            android:title="@string/list_long_press_delay"
            android:summary="@string/list_long_press_delay_summary"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            android:key="favorites_category_strip"
            android:defaultValue="true"
            android:title="@string/show_favorites_category_strip"
            android:summary="@string/show_favorites_category_strip_summary" />

        <SwitchPreferenceCompat
            android:key="new_chapter_counter"
            android:defaultValue="true"
            android:title="@string/show_new_chapter_counters"
            android:summary="@string/show_new_chapter_counters_summary" />

        <ListPreference
            android:key="fav_order"
            android:title="@string/default_favorites_sort"
            android:dialogMessage="@string/default_favorites_sort_summary"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="quick_filter"
            android:summary="@string/show_quick_filters_summary"
            android:title="@string/show_quick_filters" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="list_checkpoint"
            android:summary="@string/list_checkpoint_settings_summary"
            android:title="@string/list_checkpoint_settings" />

        <ListPreference
            android:entries="@array/progress_indicators"
            android:key="progress_indicators"
            android:title="@string/show_reading_indicators"
            app:useSimpleSummaryProvider="true" />

        <MultiSelectListPreference
            android:defaultValue="@array/values_list_badges"
            android:entries="@array/list_badges"
            android:entryValues="@array/values_list_badges"
            android:key="manga_list_badges"
            android:title="@string/badges_in_lists" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/details">

        <SwitchPreferenceCompat
            android:key="chapter_date_sort_default"
            android:defaultValue="false"
            android:title="@string/sort_chapters_by_date"
            android:summary="@string/sort_chapters_by_date_summary" />

        <SwitchPreferenceCompat
            android:key="details_chapters_inline"
            android:defaultValue="false"
            android:title="@string/details_chapters_inline"
            android:summary="@string/details_chapters_inline_summary" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="description_collapse"
            android:title="@string/collapse_long_description" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="pages_tab"
            android:summary="@string/show_pages_thumbs_summary"
            android:title="@string/show_pages_thumbs" />

        <ListPreference
            android:defaultValue="-1"
            android:dependency="pages_tab"
            android:entries="@array/details_tabs"
            android:entryValues="@array/details_tabs_values"
            android:key="details_tab"
            android:title="@string/default_tab"
            app:useSimpleSummaryProvider="true" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/main_screen">

        <MultiSelectListPreference
            android:key="search_suggest_types"
            android:title="@string/search_suggestions" />

        <PreferenceScreen
            android:fragment="org.koitharu.kotatsu.settings.nav.NavConfigFragment"
            android:key="nav_main"
            android:title="@string/main_screen_sections" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="main_fab"
            android:summary="@string/main_screen_fab_summary"
            android:title="@string/main_screen_fab" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="nav_labels"
            android:title="@string/show_labels_in_navbar" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="nav_pinned"
            android:summary="@string/pin_navigation_ui_summary"
            android:title="@string/pin_navigation_ui" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="nav_floating"
            android:summary="@string/floating_navigation_bar_summary"
            android:title="@string/floating_navigation_bar" />

        <org.koitharu.kotatsu.settings.utils.SliderPreference
            android:dependency="nav_floating"
            android:key="nav_corner_radius"
            android:stepSize="2"
            android:title="@string/navigation_bar_corner_radius"
            android:valueFrom="0"
            android:valueTo="40"
            app:defaultValue="36" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="exit_confirm"
            android:summary="@string/exit_confirmation_summary"
            android:title="@string/exit_confirmation" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="dynamic_shortcuts"
            android:summary="@string/history_shortcuts_summary"
            android:title="@string/history_shortcuts" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/privacy">

        <SwitchPreferenceCompat
            android:key="protect_app"
            android:persistent="false"
            android:summary="@string/protect_application_summary"
            android:title="@string/protect_application" />

        <ListPreference
            android:defaultValue="allow"
            android:entries="@array/screenshots_policy"
            android:key="screenshots_policy"
            android:title="@string/screenshots_policy"
            app:useSimpleSummaryProvider="true" />

    </PreferenceCategory>

</PreferenceScreen>
